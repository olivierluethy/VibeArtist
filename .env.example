# Leave unset to run the prototype in mock mode (uses the built-in fixture portrait).
# Set both to switch on the real face-preserving image API.
#
# Pre-wired for fal.ai FLUX PuLID (identity-preserving portrait). To go live:
#   1. Create a fal.ai account and API key: https://fal.ai/dashboard/keys
#   2. Fill in PORTRAIT_API_KEY below and restart.
# fal authenticates with "Key <token>" (handled by the adapter); keys stay server-side only.

PORTRAIT_API_URL=https://fal.run/fal-ai/flux-pulid
PORTRAIT_API_KEY=

# Async (queue) providers only — leave unset for the default synchronous fal.run endpoint.
# Set PORTRAIT_API_POLL=1 to poll a job until done (e.g. https://queue.fal.run/...).
# PORTRAIT_API_POLL=1
# PORTRAIT_API_POLL_INTERVAL_MS=1500
# PORTRAIT_API_POLL_TIMEOUT_MS=60000

# Face detection (M3.4 BlazeFace) runs by default and sharpens the eyes/mouth pass; it degrades
# cleanly to the pure detail-driven path on any failure. Set to 0 to force it off.
# PORTRAIT_FACE_DETECT=0
